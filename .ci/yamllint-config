# yamllint configuration for jol-llm (used by CI and local pre-commit).
---
extends: default

ignore: |
  .venv/
  .idea/
  .git/

rules:
  line-length:
    max: 140
    level: warning
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
    check-keys: false        # GitHub workflows legitimately use `on:`
  comments:
    min-spaces-from-content: 1
  document-start:
    present: false           # GitHub workflow files don't use `---`
  indentation:
    spaces: 2
    indent-sequences: consistent
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: false
